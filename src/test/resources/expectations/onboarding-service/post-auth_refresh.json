{
  "httpRequest": {
    "method": "POST",
    "path": "/onboarding/auth/refresh"
  },
  "httpResponse": {
    "statusCode": 200,
    "headers": {
      "Content-Type": ["application/json"]
    },
    "body": {
      "access_token": "access-token-from-target",
      "expires_in": 300,
      "refresh_token": "refresh-token-from-target",
      "refresh_expires_in": 1800,
      "token_type": "Bearer"
    }
  }
}
